# Stripe Dashboard → Developers → API keys
# https://dashboard.stripe.com/apikeys
#
# Leave blank to keep checkout disabled. This project never creates simulated
# successful orders when Stripe is unavailable.
# Use test keys (pk_test_ / sk_test_) for local integration testing.
# Development accepts Stripe test keys only. Production accepts live keys only,
# and both require DATABASE_URL, STRIPE_WEBHOOK_SECRET, and CHECKOUT_ENABLED=true.

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Required for production payments
# stripe listen --forward-to localhost:4242/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Explicit operator switch. Keep false until webhook delivery and product
# policies have been verified. Development accepts test keys only; production
# accepts live keys only.
CHECKOUT_ENABLED=false

# Public site URL (used later for redirects / webhooks)
# Example: https://your-domain.com
PUBLIC_BASE_URL=http://127.0.0.1:4242

# API server
PORT=4242

# Set to production only in the deployed production service.
NODE_ENV=development

# PostgreSQL (required for production sessions, inventory, orders, audit search)
# Local Homebrew example:
# DATABASE_URL=postgresql://orbmare:orbmare_dev@127.0.0.1:5432/orbmare
# Or: npm run db:up  (Docker Compose Postgres 16)
DATABASE_URL=

# Seller self-registration invite code (required in production).
# Leave empty in development to allow open seller signup.
SELLER_INVITE_CODE=

# Private operations console
#
# ADMIN_ROUTE must be a single hard-to-guess path segment. Do not use /admin.
# Generate a password hash with:
# npm run admin:hash-password
# Never commit the generated hash, the password, or the private route.

ADMIN_ROUTE=
# Optional dedicated admin hostname (e.g. admin.orbmare.com). Same Node process.
ADMIN_HOST=
# prefer | db | json — how /api/editorial-catalog resolves product source
EDITORIAL_DB_SOURCE=prefer
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Development only. Production ignores ADMIN_PASSWORD and requires the hash.
ADMIN_PASSWORD=

# Admin can also sign in at /auth/ (role=admin) to use site edit mode.
# Optional legacy JSON directory (used only when DATABASE_URL is empty).
# Prefer PostgreSQL for durable ops data. Also stores site-content.json for CMS.
ADMIN_DATA_DIR=

# Google OAuth (optional — enable only after configuring this exact callback in Google Cloud)
# Local callback: http://127.0.0.1:4242/auth/api/google/callback
# Production callback: https://your-domain.com/auth/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend recommended for MVP)
# Verify your sender domain in Resend before production use.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Orbmare <orders@orbmare.com>
EMAIL_REPLY_TO=support@orbmare.com
SUPPORT_EMAIL=support@orbmare.com

# Storyblok Visual Editor（后台杂志制作）
# 后台只读取配置状态与打开编辑器；不要把 token 暴露到前端页面。
STORYBLOK_SPACE_ID=
STORYBLOK_REGION=eu
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_EDITOR_URL=
STORYBLOK_PREVIEW_URL=http://127.0.0.1:4242/journal/

# ---------------------------------------------------------------------------
# AI content optimization (OpenAI Responses API — server-side only)
# Never expose OPENAI_API_KEY to the browser. Model IDs come only from env.
# Docs: https://developers.openai.com/api/docs/models
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Standard tier — GPT-5.6 Luna (cost-sensitive, high-volume editorial copy)
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
# Premium tier — GPT-5.6 Terra (higher quality / balanced intelligence)
OPENAI_PREMIUM_MODEL=gpt-5.6-terra
OPENAI_AI_FEATURE_ENABLED=true
OPENAI_MAX_INPUT_CHARS=30000
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_DAILY_LIMIT_PER_USER=200
OPENAI_MONTHLY_LIMIT_PER_USER=3000
OPENAI_RATE_LIMIT_PER_MINUTE=20
# Optional rough USD / 1M tokens for cost logging
OPENAI_COST_PER_1M_INPUT=1.25
OPENAI_COST_PER_1M_OUTPUT=10
