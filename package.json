    "node": ">=18"
  },
  "dependencies": {
    "@tinacms/cli": "^2.5.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "openai": "^4.104.0",
    "pg": "^8.22.0",
    "stripe": "^18.5.0",
    "tinacms": "^3.11.0"
